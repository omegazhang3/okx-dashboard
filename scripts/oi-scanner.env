# OI 异动扫描器配置

# 扫描间隔（秒）：300=5分钟, 600=10分钟, 1800=30分钟
SCAN_INTERVAL=300

# OI 24h变化% 最小阈值（50% = 只关注显著异动）
OI_CHANGE_MIN=50

# 价格24h变化% 最大阈值（横盘定义）
PRICE_CHANGE_MAX=5.0

# 最小OI金额（美元）（100M = 过滤小盘币，避免 % 变化虚高）
MIN_OI_USD=100000000

# 最小24h成交量（美元）
MIN_VOL_USD=10000000

# 最多显示前N个
TOP_N=5

# 最低评分阈值（score = OI变化% / max(价格变化%, 0.1)）
MIN_SCORE=20

# 资金费率过滤（yes = 只推送负费率信号，空头积累更有价值）
FUNDING_RATE_FILTER=yes

# 连续确认（yes = 信号需在连续两次扫描中都出现才推送）
CONSECUTIVE_CONFIRM=yes
